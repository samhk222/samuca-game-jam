#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"

if [ ! -x "$GODOT_BIN" ]; then
	echo "Godot is not installed. Run ./scripts/bootstrap first." >&2
	exit 1
fi

has_path=false
for argument in "$@"; do
	if [ "$argument" = "--path" ]; then
		has_path=true
		break
	fi
done

if [ "$has_path" = true ]; then
	exec "$GODOT_BIN" "$@"
fi

exec "$GODOT_BIN" --path "$REPO_ROOT" "$@"
