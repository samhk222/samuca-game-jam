#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"

if [ ! -f "$REPO_ROOT/build/web/index.html" ]; then
	echo "No Web build found. Run ./scripts/export-web first." >&2
	exit 1
fi

if [ "${HTTP_ONLY:-0}" = "1" ]; then
	default_host=127.0.0.1
else
	default_host=0.0.0.0
	if ! command -v tailscale >/dev/null 2>&1; then
		echo "HTTPS needs Tailscale installed and signed in. For local-only play: HTTP_ONLY=1 ./scripts/serve-web" >&2
		exit 1
	fi
fi

exec "$NODE_DIR/bin/node" "$REPO_ROOT/tools/serve-web.mjs" "$REPO_ROOT/build/web" "${PORT:-7777}" "${HOST:-$default_host}"
