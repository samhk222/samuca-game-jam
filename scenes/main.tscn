[node name="Tagline" type="Label" parent="Margin/Columns/Left"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.78, 1)
theme_override_font_sizes/font_size = 13
text = "Only one candle is different. Remember where it was."
