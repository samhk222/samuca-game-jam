[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/main.gd" type="Script" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.055, 0.11, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.42, 0.84, 1, 1)
theme_override_font_sizes/font_size = 42
text = "Hello, world!"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.9, 1)
theme_override_font_sizes/font_size = 20
text = "Your first Godot WebGL game"
horizontal_alignment = 1

[node name="Counter" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "Count: 0"
horizontal_alignment = 1

[node name="CountButton" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(280, 64)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "Count up!"

[node name="Hint" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.8, 0.9, 1)
theme_override_font_sizes/font_size = 16
text = "Click or tap the button. Refresh to start over."
horizontal_alignment = 1

[connection signal="pressed" from="Center/Content/CountButton" to="." method="_on_count_button_pressed"]
