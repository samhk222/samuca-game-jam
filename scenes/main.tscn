[node name="FlashButton" type="Button" parent="Margin/Columns/Right"]
layout_mode = 2
tooltip_text = "Lights everything up for half a second."
text = "Flash (+3 s)"

[node name="LanternButton" type="Button" parent="Margin/Columns/Right"]
layout_mode = 2
tooltip_text = "A light follows your mouse for 4 seconds."
text = "Flashlight (+5 s)"

[node name="RadarButton" type="Button" parent="Margin/Columns/Right"]
layout_mode = 2
tooltip_text = "For 3 seconds your cursor turns red near the candle and blue far away."
text = "Radar (+4 s)"

[node name="PowerHelp" type="Label" parent="Margin/Columns/Right"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.68, 1)
theme_override_font_sizes/font_size = 12
text = "Flash: lights everything for 0.5 s.
Flashlight: light around the mouse for 4 s.
Radar: cursor heats up near the candle for 3 s.

Wrong click: +1 s."
autowrap_mode = 3
